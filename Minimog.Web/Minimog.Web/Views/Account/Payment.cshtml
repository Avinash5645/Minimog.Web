@{
    ViewBag.Title = "Payment";
}

<div class="container py-5">

    <form id="paymentForm" action="">

        <div class="row mb-4">

            <div class="col-md-6">
                <h3 class="title mb-4">Delivery Address</h3>

                <div class="mb-3">
                    <label for="fullName" class="form-label">Full Name:</label>
                    <input type="text" class="form-control" id="fullName" placeholder="Enter Your Name">
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <input type="email" class="form-control" id="email" placeholder="Enter Your E-Mail">
                </div>
                <div class="mb-3">
                    <label for="address" class="form-label">Address:</label>
                    <input type="text" class="form-control" id="address" placeholder="Enter Your Address">
                </div>
                <div class="mb-3">
                    <label for="city" class="form-label">City:</label>
                    <input type="text" class="form-control" id="city" placeholder="Enter Your City">
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="state" class="form-label">State:</label>
                        <input type="text" class="form-control" id="state" placeholder="Enter Your State">
                    </div>
                    <div class="col-md-6">
                        <label for="zip" class="form-label">PinCode:</label>
                        <input type="text" class="form-control" id="zip" placeholder="Enter PinCode">
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <h3 class="title mb-4">Payment</h3>
                <div class="mb-3">
                    <label for="nameOnCard" class="form-label">Name on Card:</label>
                    <input type="text" class="form-control" id="nameOnCard" placeholder="Enter Name On Card">
                </div>
                <div class="mb-3">
                    <label for="cardNumber" class="form-label">Credit Card Number:</label>
                    <input type="number" class="form-control" id="cardNumber" placeholder="Enter Card Number">
                </div>
                <div class="mb-3">
                    <label for="expMonth" class="form-label">Exp Month:</label>
                    <input type="text" class="form-control" id="expMonth" placeholder="Enter Expiry Month ">
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="expYear" class="form-label">Exp Year:</label>
                        <input type="number" class="form-control" id="expYear" placeholder="Enter Expiry Year">
                    </div>
                    <div class="col-md-6">
                        <label for="cvv" class="form-label">CVV:</label>
                        <input type="text" class="form-control" id="cvv" placeholder="Enter CVV">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="amtPay" class="form-label">Total Amount To Pay</label>
                    <input type="number" class="form-control" id="amtPay" ng-model="Total" disabled>
                </div>
                <div class="p-5">
                    <label class="form-label">Cards Accepted:</label>
                    <img src="~/Images/card_img.png" alt="Cards Accepted" class="img-fluid">
                </div>
            </div>
        </div>

        <div class="d-grid">
            <input type="submit" value="Proceed to Payment" class="btn btn-dark btn-lg">
        </div>
    </form>
</div>

<script>
    document.getElementById('paymentForm').addEventListener('submit', function (event) {
        event.preventDefault(); // Prevent the form from submitting the traditional way

        // Check if any field is empty
        const fields = document.querySelectorAll('#paymentForm input');
        let allFieldsFilled = true;
        fields.forEach(function (field) {
            if (field.value.trim() === '') {
                allFieldsFilled = false;
                return;
            }
        });

        // Display message if all fields are filled
        if (allFieldsFilled) {
            let x = Math.floor(Math.random() * 1000000); // Generates a random number between 0 and 999999
            alert('Payment Successful. Order no: ' + x);
            // Optionally, you can submit the form here using AJAX or other methods if needed
        } else {
            alert('Please fill out all fields before proceeding to payment.');
        }
    });
</script>