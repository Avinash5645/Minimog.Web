    @* Offcanvas Section Start *@
  
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel" data-bs-backdrop="false">
        <div class="offcanvas-header">
            <h5 id="offcanvasRightLabel">Add To Cart</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body container-fluid">
            <div class="product-info">
                <div class="row mb-1" ng-repeat="item in cartItems">
                    <div class="col-4">
                        <img src="~/Images/{{item.image}}" alt="Product Image" class="img-fluid">
                    </div>
                    <div class="col-8">
                        <h6>{{item.title}}</h6>
                        <p>${{item.price}}</p>
                        <div class="input-group">
                            <button class="btn btn-outline-secondary" type="button" id="button-decrease" ng-click="decrementItem(item)">-</button>
                            <input type="text" class="form-control text-center" aria-label="Quantity" ng-model="item.quantity" ng-blur="enterQuantityItem(item)" ng-keypress="($event.which === 13) && enterQuantityItem(item)">
                            <button class="btn btn-outline-secondary" type="button" id="button-increase" ng-click="incrementItem(item)">+</button>
                        </div>
                        <button type="button" class="btn btn-danger mt-2" ng-click="removeFromCart($index)">
                            <i class="fa-solid fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="button" class="btn btn-primary btn-lg" onclick="redirectToPayment()" ng-click="checkout()">
                        <i class="fa-solid fa-credit-card"></i> Check Out (Total: ${{ Total }})
                    </button>
                </div>
            </div>
        </div>
    </div>
    @* Offcanvas Section End *@

