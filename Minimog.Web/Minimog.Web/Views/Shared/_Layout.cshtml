    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script>
        //quantity inc/dec start
        document.getElementById('button-decrease').addEventListener('click', function () {
            let quantityInput = this.nextElementSibling;
            let currentValue = parseInt(quantityInput.value);
            if (currentValue > 1) {
                quantityInput.value = currentValue - 1;
            }
        });

        document.getElementById('button-increase').addEventListener('click', function () {
            let quantityInput = this.previousElementSibling;
            let currentValue = parseInt(quantityInput.value);
            quantityInput.value = currentValue + 1;
        });
        //quantity inc/dec end
        $(window).scroll(function () {
            if ($(this).scrollTop() > 100) {
                $('#dynamicNav').addClass('shadow p-3 mb-5 bg-body-tertiary');
            } else {
                $('#dynamicNav').removeClass('shadow p-3 mb-5 bg-body-tertiary');
            }
        });


        const closeIcon = document.getElementById('closeIcon');
        const banner = document.querySelector('.main-discount-banner');

        closeIcon.addEventListener('click', () => {
            banner.style.animation = 'fadeOut 1s'; // Add the fadeOut animation class
            setTimeout(() => {
                banner.style.display = 'none'; // Hide the banner after the animation completes
            }, 1000); // Wait for the animation duration (1s) before hiding the banner
        });

        function removednone() {
            //  document.getElementById("productsearch").innerHTML = Date();
            var element = document.getElementById("productsearch");
            element.classList.remove("d-none");
        }


        document.addEventListener('DOMContentLoaded', (event) => {
            const bucketIcon = document.getElementById('bucketIcon');
            bucketIcon.addEventListener('click', () => {
                // Trigger the offcanvas
                var offcanvasElement = new bootstrap.Offcanvas(document.getElementById('offcanvasRight'));
                offcanvasElement.show();
            });
        });

        //redirect from checkout to payment
        function redirectToPayment() {
            window.location.href = '/Account/payment';
        }
    </script>
